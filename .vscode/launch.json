{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Godot (Windows) - Editor [cppvsdbg]",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\..\\Engine\\bin\\godot.windows.editor.x86_64.exe",
      "args": [
        "--path",
        "${workspaceFolder}\\UnamedProject\\",
        "--editor"
      ],
      "cwd": "${workspaceFolder}\\UnamedProject\\",
      "stopAtEntry": false
    },
    {
      "name": "Godot (Windows) - Main",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\..\\Engine\\bin\\godot.windows.editor.x86_64.exe",
      "args": [
        "--path",
        "${workspaceFolder}\\UnamedProject\\"
      ],
      "cwd": "${workspaceFolder}\\UnamedProject\\",
      "stopAtEntry": false
    },
    {
      "name": "Godot Debug - Game (SpecificScene)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\..\\Engine\\bin\\godot.windows.editor.x86_64.exe",
      "args": [
        "--path",
        "${workspaceFolder}\\UnamedProject\\",
        "--verbose",
        "res://Scenes/Ruben_Testing.tscn"
      ],
      "cwd": "${workspaceFolder}\\UnamedProject\\",
      "stopAtEntry": false
    }
  ]
}